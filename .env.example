VITE_DATA_MODE=api
VITE_AUTH_MODE=disabled
VITE_DEMO_BUILD=false
VITE_API_BASE=/api/v1
DEV_BACKEND_TARGET=http://127.0.0.1:8080
VITE_APP_LABEL=Recette institutionnelle

# OIDC : client public, Authorization Code + PKCE ; aucun client_secret.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email

# Supabase Auth uniquement : URL du projet et cle PUBLIC publishable/anon.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
