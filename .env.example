VITE_DATA_MODE=connected
VITE_AUTH_MODE=disabled
VITE_API_BASE=/api/v1
VITE_APP_LABEL=Recette institutionnelle
DEV_BACKEND_TARGET=http://127.0.0.1:8080
# Port du serveur Vite de développement (5173 par défaut) ; à changer si un autre projet l'occupe.
# DEV_SERVER_PORT=5174
# Choisir oidc OU supabase après configuration en recette. Aucun secret serveur.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
